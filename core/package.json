{
  "name": "lm-assist-core",
  "version": "0.1.135",
  "description": "Backend API for lm-assist \u2014 session management, milestones, knowledge, architecture, and hub connectivity",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lm-assist": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist dist-test",
    "start": "node dist/cli.js serve",
    "test": "npm run build:test && node scripts/run-tests.js",
    "test:live": "RUN_LIVE_CC=1 npm run test",
    "test:raw": "node --test --test-reporter=spec --test-timeout=300000 dist-test/__tests__/**/*.test.js"
  },
  "author": "YiHuangDB",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@hono/node-server": "^1.19.9",
    "@huggingface/transformers": "^3.8.1",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@msgpack/msgpack": "^3.1.3",
    "@types/chokidar": "^1.7.5",
    "better-sqlite3": "^11.10.0",
    "check-disk-space": "^3.4.0",
    "chokidar": "^3.6.0",
    "find-process": "^2.0.0",
    "get-port-please": "^3.2.0",
    "hono": "^4.11.5",
    "http-proxy": "^1.18.1",
    "lmdb": "^3.5.1",
    "pidtree": "^0.6.0",
    "tree-kill": "^1.2.2",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ]
}
