# ANTHROPIC_API_KEY=your-key    # For AI summaries/architecture
# API_PORT=3100                  # Core API port
# WEB_PORT=3848                  # Web UI port
# TIER_AGENT_HUB_URL=wss://...  # Hub gateway (optional)
# TIER_AGENT_API_KEY=sk-...     # Hub API key (optional)
# LM_HTTPS=1                     # Opt-in HTTPS terminator on WEB_PORT+1 (dev :3949 / prod :3849):
#                                # secure-context page + same-origin /_coreapi + wss voice, so the
#                                # mic works from other LAN devices. Self-signed cert auto-managed
#                                # in ~/.lm-assist/tls[-dev]/ — see docs/voice-https-transport.md.
# LM_HTTPS_PORT=3949             # Override the terminator port (default WEB_PORT+1)
# MEMORY_AUTOSYNC=observe        # Cross-node memory autosync: off|observe|on (default observe).
#                                # observe = detect+log sync PLAN only (no git writes); on = real mirror+commit+push+hub-notify.
# MEMORY_HARVEST_DAEMON=off      # Periodic memory harvest daemon: off (default) | on.
#                                # When off: Core logs "harvest daemon: disabled" and does nothing (no timers, no Opus).
#                                # When on: runs memory-harvest.js on a schedule in propose-only mode
#                                #   (writes proposals to ~/.lm-assist/memory-proposals.jsonl; never writes memory
#                                #   files, never git). Review proposals manually before promoting.
# MEMORY_HARVEST_INTERVAL_HOURS=6  # Sweep interval in hours (default 6). Fractional values allowed (e.g. 0.5).
# MEMORY_HARVEST_RUN_ON_BOOT=off   # Run a tick 2s after Core starts (off by default -- waits one full interval).
