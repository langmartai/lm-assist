# ANTHROPIC_API_KEY=your-key    # For AI summaries/architecture
# API_PORT=3100                  # Core API port
# WEB_PORT=3848                  # Web UI port
# TIER_AGENT_HUB_URL=wss://...  # Hub gateway (optional)
# TIER_AGENT_API_KEY=sk-...     # Hub API key (optional)
# MEMORY_AUTOSYNC=observe        # Cross-node memory autosync: off|observe|on (default observe).
#                                # observe = detect+log sync PLAN only (no git writes); on = real mirror+commit+push+hub-notify.
